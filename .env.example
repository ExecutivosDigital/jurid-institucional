# ===== Analytics / Marketing Tags =====
# Cada variável é opcional — o script só é injetado se houver valor.
# Reinicie o servidor de dev (npm run dev) após alterar estas variáveis.

# Meta (Facebook) Pixel — ex.: 1234567890123456
NEXT_PUBLIC_META_PIXEL_ID=

# Google Tag Manager — ex.: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 (opcional — já existe um GA hardcoded no layout)
NEXT_PUBLIC_GA_ID=

# LinkedIn Insight Tag (Partner ID) — ex.: 1234567
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# TikTok Pixel — ex.: C4A1B2C3D4E5F6G7H8
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
